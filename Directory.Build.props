<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Suppress rules that conflict with intentional design decisions:
         CA1003: our events use ReadOnlyMemory<byte> for zero-copy perf (not EventArgs subclass)
         CA1819: CredentialMaterial byte[] arrays must be mutable for zeroing on Dispose
         CA2227: ConnectionProfile.Settings intentionally mutable for store layer
         CA1724: SessionState naming - System.Web.SessionState is not in scope
         CA1716: IProtocolRegistry.Find / RenameAsync 'destination' param renamed below
         CA1062: null checks on public methods would be noise throughout
         CA1014: CLSCompliant attribute not required
         CA2007: ConfigureAwait(false) — callers choose; engine uses it explicitly
    -->
    <NoWarn>CA1062;CA1014;CA2007;CA1003;CA1819;CA2227;CA1724;CA1051;CA1028;CA1848;CA1031;CA5392;CA1711;CA1832;CA1859;CA1707;CA1873</NoWarn>
  </PropertyGroup>

  <!-- Release version. All 8 build-order projects share this so a packaged release has one
       consistent number everywhere (PolyTerm.exe's file properties, the MSI's ProductVersion, the
       portable zip's filename). Bump this — nothing else — before pushing a vX.Y.Z tag: release.yml
       fails the build if the tag and this version disagree. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>PolyTerm</Company>
    <Product>PolyTerm</Product>
    <Copyright>Copyright © PolyTerm contributors</Copyright>
  </PropertyGroup>
</Project>
