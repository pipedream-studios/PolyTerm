<Solution>
  <!--
    Cross-platform subset of PolyTerm.slnx — everything here targets plain net10.0 and has no
    Windows-only dependency (WinForms/COM interop, real UI automation). Exists specifically for CI's
    ubuntu-latest/macos-latest legs. PolyTerm.App and PolyTerm.App.Tests were Windows-only through
    issue #83 (net10.0-windows, forced by the MSTSC-based PolyTerm.Protocols.Rdp) - both build
    cross-platform as of issue #84's move to FreeRDP everywhere. PolyTerm.FlaUI.Tests still can't:
    it drives real OS-level UI automation against a live PolyTerm.exe window, which has no
    cross-platform equivalent in this repo.

    tests/PolyTerm.Protocols.Ssh.Tests is deliberately excluded even though it builds fine here:
    FakeSshServer hardcodes C:\Windows\System32\OpenSSH\sshd.exe, so its tests would fail at
    runtime (not build-time) on Linux/macOS. See .github/workflows/ci.yml for how this file is used.

    tests/PolyTerm.Protocols.Serial.Tests is excluded for the same category of reason: its real-device
    test depends on a specific physical COM port (a real Cisco switch's console cable) only present on
    one developer's machine - it skips gracefully everywhere else, but there's no CI value in building
    it here either.

    tests/PolyTerm.Protocols.LocalShell.Tests is excluded because its test hardcodes "cmd.exe" as the
    shell to cover a Windows-ConPTY-specific bug (see issue #23/#2 - UpdateProcThreadAttribute needed
    the pseudoconsole handle passed by value, not by ref) - it wouldn't build a meaningful check on
    Linux/macOS, which use UnixPtyTerminal instead and never hit this code path at all.
  -->
  <Folder Name="/src/">
    <Project Path="src/PolyTerm.App.Surfaces/PolyTerm.App.Surfaces.csproj" />
    <Project Path="src/PolyTerm.App/PolyTerm.App.csproj" />
    <Project Path="src/PolyTerm.Cli/PolyTerm.Cli.csproj" />
    <Project Path="src/PolyTerm.Engine.Abstractions/PolyTerm.Engine.Abstractions.csproj" />
    <Project Path="src/PolyTerm.Engine/PolyTerm.Engine.csproj" />
    <Project Path="src/PolyTerm.Mcp/PolyTerm.Mcp.csproj" />
    <Project Path="src/PolyTerm.Protocols.LocalShell/PolyTerm.Protocols.LocalShell.csproj" />
    <Project Path="src/PolyTerm.Protocols.RdpFreerdp/PolyTerm.Protocols.RdpFreerdp.csproj" />
    <Project Path="src/PolyTerm.Protocols.Serial/PolyTerm.Protocols.Serial.csproj" />
    <Project Path="src/PolyTerm.Protocols.Ssh/PolyTerm.Protocols.Ssh.csproj" />
    <Project Path="src/PolyTerm.Protocols.Telnet/PolyTerm.Protocols.Telnet.csproj" />
    <Project Path="src/PolyTerm.Protocols.Vnc/PolyTerm.Protocols.Vnc.csproj" />
    <Project Path="src/PolyTerm.Protocols.Web/PolyTerm.Protocols.Web.csproj" />
    <Project Path="src/PolyTerm.Terminal.Emulation/PolyTerm.Terminal.Emulation.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/PolyTerm.App.Surfaces.Tests/PolyTerm.App.Surfaces.Tests.csproj" />
    <Project Path="tests/PolyTerm.App.Tests/PolyTerm.App.Tests.csproj" />
    <Project Path="tests/PolyTerm.Cli.Tests/PolyTerm.Cli.Tests.csproj" />
    <Project Path="tests/PolyTerm.Engine.Tests/PolyTerm.Engine.Tests.csproj" />
    <Project Path="tests/PolyTerm.Mcp.Tests/PolyTerm.Mcp.Tests.csproj" />
    <Project Path="tests/PolyTerm.Protocols.RdpFreerdp.Tests/PolyTerm.Protocols.RdpFreerdp.Tests.csproj" />
    <Project Path="tests/PolyTerm.Protocols.Telnet.Tests/PolyTerm.Protocols.Telnet.Tests.csproj" />
    <Project Path="tests/PolyTerm.Protocols.Vnc.Tests/PolyTerm.Protocols.Vnc.Tests.csproj" />
    <Project Path="tests/PolyTerm.Protocols.Web.Tests/PolyTerm.Protocols.Web.Tests.csproj" />
    <Project Path="tests/PolyTerm.Terminal.Tests/PolyTerm.Terminal.Tests.csproj" />
  </Folder>
</Solution>
