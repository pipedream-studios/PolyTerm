<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PolyTerm.Engine</AssemblyName>
    <RootNamespace>PolyTerm.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolyTerm.Engine.Abstractions\PolyTerm.Engine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Direct override of a transitive dependency, not incidental - see Directory.Packages.props'
         own comment on this package for why (CVE-2025-6965, GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <!-- Argon2id KDF support for BitwardenCrypto - .NET has no built-in Argon2 implementation.
         Already a dependency of PolyTerm.App (MRemoteNgPasswordCrypto.cs); this is the same
         package, just also needed here now. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
</Project>
