<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net10.0 (inherited from Directory.Build.props), not net10.0-windows: the only thing
         that used to force the Windows-only TFM was PolyTerm.Protocols.Rdp's MSTSC ActiveX control
         (net10.0-windows + UseWindowsForms). RDP is now FreeRDP-backed everywhere
         (PolyTerm.Protocols.RdpFreerdp, cross-platform, SurfaceKind.Framebuffer), so nothing left in
         this project's dependency graph needs Windows-only APIs. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>PolyTerm</AssemblyName>
    <RootNamespace>PolyTerm.App</RootNamespace>
    <UseAvalonia>true</UseAvalonia>
    <!-- Avalonia XAML compiler requires this -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so MainWindow can also reference it via avares:// for the window's own title-bar
         icon, not just the exe's own icon (which ApplicationIcon above already covers). -->
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolyTerm.Engine.Abstractions\PolyTerm.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\PolyTerm.Engine\PolyTerm.Engine.csproj" />
    <ProjectReference Include="..\PolyTerm.App.Surfaces\PolyTerm.App.Surfaces.csproj" />
    <ProjectReference Include="..\PolyTerm.Terminal.Emulation\PolyTerm.Terminal.Emulation.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.Ssh\PolyTerm.Protocols.Ssh.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.LocalShell\PolyTerm.Protocols.LocalShell.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.RdpFreerdp\PolyTerm.Protocols.RdpFreerdp.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.Telnet\PolyTerm.Protocols.Telnet.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.Serial\PolyTerm.Protocols.Serial.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.Vnc\PolyTerm.Protocols.Vnc.csproj" />
    <ProjectReference Include="..\PolyTerm.Protocols.Web\PolyTerm.Protocols.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>
</Project>
