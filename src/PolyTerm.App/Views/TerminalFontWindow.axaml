<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.TerminalFontWindow"
        Title="Terminal Font"
        Width="460" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="4">
    <TextBlock Text="Terminal Font" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
      Applies to every terminal tab. The bundled fonts look the same on Windows, macOS and Linux;
      installed monospace fonts are listed after them. Ctrl+mouse wheel still zooms a single tab.
    </TextBlock>

    <TextBlock Text="Font" FontSize="12" />
    <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch" Margin="0,2,0,2"
              MaxDropDownHeight="420"
              SelectionChanged="FontCombo_SelectionChanged" />
    <TextBlock x:Name="InstalledStatus" FontSize="11" Margin="0,0,0,10"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               Text="Looking for installed monospace fonts…" />

    <TextBlock Text="Size" FontSize="12" />
    <NumericUpDown x:Name="SizeBox" Minimum="6" Maximum="48" Increment="1" FormatString="0"
                   HorizontalAlignment="Left" Width="140" Margin="0,2,0,12"
                   ValueChanged="SizeBox_ValueChanged" />

    <TextBlock Text="Preview" FontSize="12" />
    <Border Background="#1E1E1E" CornerRadius="4" Padding="12,10" Margin="0,2,0,4" Height="120" ClipToBounds="True">
      <StackPanel x:Name="PreviewPanel" Spacing="0">
        <TextBlock x:Name="PreviewPrompt" Foreground="#4CAF50" FontWeight="Bold" Text="rob@destiny:~$ ls -la" />
        <TextBlock x:Name="PreviewLine1" Foreground="#CCCCCC" Text="drwxr-xr-x  2 rob rob  4096 Oct 30 13:00 docs" />
        <TextBlock x:Name="PreviewLine2" Foreground="#CCCCCC" Text="-rw-r--r--  1 rob rob  7172 Oct 30 13:00 README.md" />
        <TextBlock x:Name="PreviewLine3" Foreground="#6A9FB5" Text="0O 1lI| {}[]() =&gt; != == ~~ ┌─┐ ✓" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Width="90" Click="Cancel_Click" />
      <Button Content="Save" Width="90" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
