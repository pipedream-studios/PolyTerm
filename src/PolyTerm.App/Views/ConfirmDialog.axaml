<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.ConfirmDialog"
        Title="Confirm"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="14">
    <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" FontSize="13" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="ActionButton" Content="Delete" Click="Confirm_Click"
              Foreground="White" Background="#CC2200" />
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
