<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PolyTerm.App.ViewModels"
        x:Class="PolyTerm.App.Views.RenameWindow"
        x:DataType="vm:RenameViewModel"
        Title="Rename"
        Width="320" Height="130"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Width="80" Click="Cancel_Click" />
      <Button Content="OK" Width="80" Command="{Binding SaveCommand}" IsDefault="True" />
    </StackPanel>

    <TextBox Text="{Binding Name}" />

  </DockPanel>
</Window>
