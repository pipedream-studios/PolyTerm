<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.VaultSettingsWindow"
        Title="Vault Provider"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="4">
    <TextBlock Text="Credential Vault Provider" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
      The OS keychain is always available. Selecting KeePass or Bitwarden here additionally lets
      connections use credentials from that vault instead — KeePass requires its own local service
      already running (KeePassRPC); Bitwarden talks directly to your vault server, no separate
      service needed.
    </TextBlock>

    <TextBlock Text="Provider" FontSize="12" />
    <ComboBox x:Name="ProviderCombo" HorizontalAlignment="Stretch" Margin="0,2,0,12"
              SelectionChanged="ProviderCombo_SelectionChanged">
      <ComboBoxItem Content="None (OS keychain only)" />
      <ComboBoxItem Content="KeePass" />
      <ComboBoxItem Content="Bitwarden" />
    </ComboBox>

    <StackPanel x:Name="KeePassPanel" IsVisible="False">
      <TextBlock Text="KeePassRPC Port" FontSize="12" />
      <TextBox x:Name="KeePassPortBox" Margin="0,2,0,8" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="KeePassPairButton" Content="Pair with KeePass…" Click="KeePassPair_Click"
                IsVisible="False" HorizontalAlignment="Left" Margin="0,0,0,4" />
        <Button x:Name="KeePassForgetPairingButton" Content="Forget Pairing" Click="KeePassForgetPairing_Click"
                IsVisible="False" HorizontalAlignment="Left" Margin="0,0,0,4" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="BitwardenPanel" IsVisible="False">
      <TextBlock Text="Vault Server URL" FontSize="12"
                 ToolTip.Tip="The Bitwarden cloud vault (https://vault.bitwarden.com) or your own self-hosted Vaultwarden server." />
      <TextBox x:Name="BitwardenUrlBox" Margin="0,2,0,8" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="BitwardenLoginButton" Content="Log In / Unlock…" Click="BitwardenLogin_Click"
                IsVisible="False" HorizontalAlignment="Left" Margin="0,0,0,4" />
        <Button x:Name="BitwardenForgetDeviceButton" Content="Forget This Device" Click="BitwardenForgetDevice_Click"
                IsVisible="False" HorizontalAlignment="Left" Margin="0,0,0,4" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="TestConnectionPanel" IsVisible="False" Margin="0,0,0,12" Spacing="6">
      <Button x:Name="TestConnectionButton" Content="Refresh Status" Click="TestConnection_Click" />
      <TextBlock x:Name="TestConnectionResult" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>

    <Border Background="#33FFA500" BorderBrush="#88FFA500" BorderThickness="1"
            CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
      <TextBlock Text="Restart PolyTerm for a changed provider to take effect. Both Bitwarden and KeePass can be logged in/paired from this window without restarting first — Save is only needed to make the provider active for new connections."
                 Foreground="#FFCC7700" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Width="90" Click="Cancel_Click" />
      <Button Content="Save" Width="90" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
