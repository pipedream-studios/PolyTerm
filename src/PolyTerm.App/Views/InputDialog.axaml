<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.InputDialog"
        Title="Input"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="PromptLabel" FontSize="13" />
    <TextBox x:Name="InputBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
