<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.TerminalAppearanceWindow"
        Title="Terminal Appearance"
        Width="520" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="4">
    <TextBlock Text="Terminal Appearance" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
      Applies to every terminal tab. A connection can use its own colour scheme instead (Edit connection →
      Organization). The remote shell chooses which colours its prompt and output use; the scheme decides
      what those colours look like.
    </TextBlock>

    <Grid ColumnDefinitions="*,12,140" RowDefinitions="Auto,Auto,Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Font" FontSize="12" />
      <ComboBox Grid.Row="1" Grid.Column="0" x:Name="FontCombo" HorizontalAlignment="Stretch" Margin="0,2,0,2"
                MaxDropDownHeight="420" SelectionChanged="Input_Changed" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Size" FontSize="12" />
      <NumericUpDown Grid.Row="1" Grid.Column="2" x:Name="SizeBox" Minimum="6" Maximum="48" Increment="1"
                     FormatString="0" HorizontalAlignment="Stretch" Margin="0,2,0,2"
                     ValueChanged="SizeBox_ValueChanged" />
      <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="InstalledStatus" FontSize="11" Margin="0,0,0,10"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 Text="Looking for installed monospace fonts…" />
    </Grid>

    <Grid ColumnDefinitions="*,12,140" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Colour scheme" FontSize="12" />
      <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SchemeCombo" HorizontalAlignment="Stretch" Margin="0,2,0,12"
                MaxDropDownHeight="420" SelectionChanged="Input_Changed" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Cursor" FontSize="12" />
      <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CursorCombo" HorizontalAlignment="Stretch" Margin="0,2,0,12"
                SelectionChanged="Input_Changed" />
    </Grid>

    <TextBlock Text="Preview" FontSize="12" />
    <Border x:Name="PreviewBorder" CornerRadius="4" Padding="12,10" Margin="0,2,0,4" Height="168" ClipToBounds="True">
      <StackPanel x:Name="PreviewPanel" Spacing="0" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Width="90" Click="Cancel_Click" />
      <Button Content="Save" Width="90" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
