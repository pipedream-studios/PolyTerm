<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.KeePassPairingDialog"
        Title="Pair with KeePass"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" />

    <StackPanel x:Name="CodePanel" Spacing="4" IsVisible="False">
      <TextBlock Text="Code shown in KeePass" FontSize="12" />
      <TextBox x:Name="CodeBox" />
    </StackPanel>

    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"
               Foreground="#FFE05757" IsVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
      <Button x:Name="ConfirmButton" Content="Confirm" IsDefault="True" Click="Confirm_Click" />
    </StackPanel>
  </StackPanel>
</Window>
