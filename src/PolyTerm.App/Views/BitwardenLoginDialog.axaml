<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyTerm.App.Views.BitwardenLoginDialog"
        Title="Bitwarden Login"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="HeadingText" FontSize="13" TextWrapping="Wrap" />

    <StackPanel x:Name="EmailPanel" Spacing="4">
      <TextBlock Text="Email" FontSize="12" />
      <TextBox x:Name="EmailBox" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Master Password" FontSize="12" />
      <TextBox x:Name="PasswordBox" PasswordChar="•" />
    </StackPanel>

    <StackPanel x:Name="TwoFactorPanel" Spacing="4" IsVisible="False">
      <TextBlock Text="Two-Factor Code" FontSize="12" />
      <TextBox x:Name="TwoFactorBox" />
    </StackPanel>

    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"
               Foreground="#FFE05757" IsVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
      <Button x:Name="LoginButton" Content="Log In" IsDefault="True" Click="Login_Click" />
    </StackPanel>
  </StackPanel>
</Window>
