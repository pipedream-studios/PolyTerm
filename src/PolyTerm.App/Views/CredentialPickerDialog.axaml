<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="using:PolyTerm.Engine"
        x:Class="PolyTerm.App.Views.CredentialPickerDialog"
        Title="Browse Credential Vault"
        Width="440" Height="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="Provider" FontSize="12" />
      <ComboBox x:Name="ProviderCombo" HorizontalAlignment="Stretch" SelectionChanged="ProviderCombo_SelectionChanged" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button x:Name="SelectButton" Content="Select" IsDefault="True" IsEnabled="False" Click="Select_Click" />
    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

    <ListBox x:Name="ItemsList" SelectionChanged="ItemsList_SelectionChanged" DoubleTapped="ItemsList_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="engine:CredentialSummary">
          <StackPanel Margin="0,2">
            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" />
            <TextBlock Text="{Binding Username}" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       IsVisible="{Binding Username, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
