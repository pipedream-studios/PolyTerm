<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PolyTerm.App.ViewModels"
        x:Class="PolyTerm.App.Views.QuickConnectWindow"
        x:DataType="vm:QuickConnectViewModel"
        Title="Quick Connect"
        Width="480" Height="145"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16,14,16,14">

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Width="80" Click="Cancel_Click" />
      <Button Content="Connect" Width="80" IsDefault="True"
              Command="{Binding ConnectCommand}" />
    </StackPanel>

    <!-- Input -->
    <StackPanel Spacing="4">
      <TextBox x:Name="InputBox"
               Text="{Binding Input}"
               FontSize="15"
               Watermark="user@host  ·  host:port  ·  ssh://user@host:port" />
      <TextBlock Text="Press Enter to connect  ·  Esc to cancel"
                 FontSize="11"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>

  </DockPanel>
</Window>
