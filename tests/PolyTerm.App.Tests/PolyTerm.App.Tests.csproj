<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Matches PolyTerm.App's own TargetFramework override — a plain net8.0 test project can't
         reference a net8.0-windows one (NuGet NU1201), same reason PolyTerm.App itself overrides it. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PolyTerm.Engine.Abstractions\PolyTerm.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\PolyTerm.App\PolyTerm.App.csproj" />
    <ProjectReference Include="..\..\src\PolyTerm.Protocols.Rdp\PolyTerm.Protocols.Rdp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit v3, not v2 - required by Avalonia.Headless.XUnit 12.1.0 (see Directory.Packages.props'
         own comment). xunit.runner.visualstudio needs a per-project VersionOverride to a 3.x release
         since every other test project in the solution centrally pins the 2.x version. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
</Project>
