<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net10.0 (inherited from Directory.Build.props) as of the RDP MSTSC removal: nothing
         left in this project's own test files is actually Windows-only (that was only
         Win32NativeWindowInputTests, deleted alongside MSTSC) - confirmed against a real Linux build,
         all 191 tests (including the Avalonia.Headless ones) passing there with no changes needed. -->

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PolyTerm.Engine.Abstractions\PolyTerm.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\PolyTerm.App\PolyTerm.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit v3, not v2 - required by Avalonia.Headless.XUnit 12.1.0 (see Directory.Packages.props'
         own comment). xunit.runner.visualstudio's central pin already supports both v2 and v3 core,
         so no per-project VersionOverride is needed here. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
</Project>
