<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Without this, the test host process isn't DPI-aware, so Windows silently rescales the raw
       screen coordinates Mouse.Click (SendInput) sends — confirmed directly: physical clicks landed
       well off-target (in the menu bar instead of the ribbon) until this was added, matching
       PolyTerm.App's own app.manifest (PerMonitorV2) so both processes agree on coordinate space. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
