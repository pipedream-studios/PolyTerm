<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-only: launches the real PolyTerm.exe and drives it via UIA. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- These tests are much slower/heavier than the rest of the repo's suite (real process launch,
         real window waits) — kept in their own project so `dotnet test` on everything else stays
         fast, and so this project can be run separately/opted into deliberately. -->
  </PropertyGroup>

  <!-- CI's solution-wide test step passes -p:SkipFlaUITests=true: FlaUI.Tests drives the real app and
       has to run on its own afterwards (#202). Both properties false makes dotnet test skip the project
       entirely; with only IsTestingPlatformApplication false it would count as a VSTest project, which
       MTP mode refuses. Microsoft.Testing.Platform only sets IsTestingPlatformApplication when it's
       empty, so this wins. A filter that matched nothing would instead fail the run with exit code 8. -->
  <PropertyGroup Condition="'$(SkipFlaUITests)' == 'true'">
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Only used to check SerialPort.GetPortNames() for a graceful skip in SerialConnectionTests when
         no real serial device is attached - not for driving the port itself (that's the app's job). -->
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <!-- diagnosticMessages (issue #223): xUnit's own view of discovery and execution goes into the
         run log, so if a test's result goes missing again we can see whether xUnit produced it.
         (internalDiagnosticMessages, also added for #223 to watch the VSTest result channel, was
         dropped once dotnet test moved to Microsoft Testing Platform in #326: that channel is gone.) -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not for UI automation - lets tests verify real persisted state (e.g. a saved profile's jump
         host) by reading it back through the app's own real IProfileStore, pointed at the same
         POLYTERM_DATA_DIR-isolated database the launched PolyTerm.exe just wrote to. -->
    <ProjectReference Include="..\..\src\PolyTerm.Engine\PolyTerm.Engine.csproj" />
    <ProjectReference Include="..\..\src\PolyTerm.Engine.Abstractions\PolyTerm.Engine.Abstractions.csproj" />
  </ItemGroup>
</Project>
