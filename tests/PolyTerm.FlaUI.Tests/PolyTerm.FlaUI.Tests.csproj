<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-only: launches the real PolyTerm.exe and drives it via UIA. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- These tests are much slower/heavier than the rest of the repo's suite (real process launch,
         real window waits) — kept in their own project so `dotnet test` on everything else stays
         fast, and so this project can be run separately/opted into deliberately. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not for UI automation - lets tests verify real persisted state (e.g. a saved profile's jump
         host) by reading it back through the app's own real IProfileStore, pointed at the same
         POLYTERM_DATA_DIR-isolated database the launched PolyTerm.exe just wrote to. -->
    <ProjectReference Include="..\..\src\PolyTerm.Engine\PolyTerm.Engine.csproj" />
    <ProjectReference Include="..\..\src\PolyTerm.Engine.Abstractions\PolyTerm.Engine.Abstractions.csproj" />
  </ItemGroup>
</Project>
