<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- Storage -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- SSH -->
  <ItemGroup>
    <PackageVersion Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <!-- Crypto (mRemoteNG import decryption — .NET's built-in AesGcm only supports 12-byte nonces on
       Windows/CNG, but mRemoteNG's own AeadCryptographyProvider uses 16-byte nonces, so its BouncyCastle
       dependency is used directly rather than System.Security.Cryptography.AesGcm) -->
  <ItemGroup>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <!-- Serial -->
  <ItemGroup>
    <PackageVersion Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- VNC -->
  <ItemGroup>
    <PackageVersion Include="MarcusW.VncClient" Version="1.0.0-alpha4" />
    <!-- Deliberately NOT referencing MarcusW.VncClient.Avalonia anywhere: confirmed (by trying to
         build against it) that it targets Avalonia 0.10.x, incompatible with this solution's
         Avalonia 11.2.7 — loading it would risk MissingMethodException/TypeLoadException at
         runtime. FramebufferSurface.cs implements X11 keysym mapping directly instead, using the
         documented Latin-1-direct-value convention for printable characters plus a small
         hand-written table for control keys — verified against MarcusW.VncClient's own core
         KeySymbol enum (no Avalonia dependency), not against the incompatible package. -->
  </ItemGroup>

  <!-- UI -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.2.7" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.7" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.2.7" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.7" />
    <PackageVersion Include="Avalonia.Headless" Version="11.2.7" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.2.7" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- CLI -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <!-- Real native-window UI automation for PolyTerm.exe itself (docs/testing.md's FlaUI spike,
         confirmed viable: physical Mouse.Click on a real ribbon button genuinely opened a window) -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>
