<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <!-- Storage -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Direct override, not just a transitive floor: Microsoft.Data.Sqlite's own dependency on
         SQLitePCLRaw.bundle_e_sqlite3 stays pinned at 2.1.6 through every 8.0.x release (confirmed
         empirically - even 8.0.28, the latest, still resolves 2.1.6), which is within the
         vulnerable range for CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, CVSS 9.8 - a SQLite memory
         corruption bug, fixed upstream in SQLite 3.50.2). The fix isn't available anywhere in the
         2.1.x SQLitePCLRaw line at all (2.1.11 was the last 2.x release, predating the July 2025
         CVE disclosure) - only 3.0.3+ bundles a patched native SQLite (3.50.4, confirmed via a real
         restore+run). Chosen over the Microsoft.Data.Sqlite 8.x -> 10.x jump
         dependabot/nuget/Microsoft.Data.Sqlite-10.0.9 proposes since it fixes the actual
         vulnerability without an EF/API-surface major-version bump riding along unrelated to the
         CVE itself. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- SSH -->
  <ItemGroup>
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- Crypto (mRemoteNG import decryption — .NET's built-in AesGcm only supports 12-byte nonces on
       Windows/CNG, but mRemoteNG's own AeadCryptographyProvider uses 16-byte nonces, so its BouncyCastle
       dependency is used directly rather than System.Security.Cryptography.AesGcm) -->
  <ItemGroup>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <!-- Serial -->
  <ItemGroup>
    <PackageVersion Include="System.IO.Ports" Version="10.0.11" />
    <!-- USB COM port auto-detection (issue #33) - WMI only actually works on Windows, but the
         package itself references fine on any platform; usage is guarded by OperatingSystem.IsWindows(). -->
    <PackageVersion Include="System.Management" Version="10.0.9" />
  </ItemGroup>

  <!-- VNC -->
  <ItemGroup>
    <PackageVersion Include="MarcusW.VncClient" Version="1.0.0-alpha4" />
    <!-- Deliberately NOT referencing MarcusW.VncClient.Avalonia anywhere: confirmed (by trying to
         build against it) that it targets Avalonia 0.10.x, incompatible with this solution's
         Avalonia 11.2.7 — loading it would risk MissingMethodException/TypeLoadException at
         runtime. FramebufferSurface.cs implements X11 keysym mapping directly instead, using the
         documented Latin-1-direct-value convention for printable characters plus a small
         hand-written table for control keys — verified against MarcusW.VncClient's own core
         KeySymbol enum (no Avalonia dependency), not against the incompatible package. -->
  </ItemGroup>

  <!-- UI -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Avalonia.Diagnostics is deprecated with no 12.x release - superseded by
         AvaloniaUI.DiagnosticsSupport, which supports 12.x (see PolyTerm.App.csproj's Debug-only
         reference; there's no AttachDevTools()/AttachDeveloperTools() call site in this app today,
         so this is a plain package swap, not an API migration). -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <!-- Embedded browser surface for HTTP/S sessions (WebView2-backed on Windows). Pinned at
         12.0.1 rather than matching the other Avalonia.* packages' 12.1.0 - this package's own
         release train lags the main Avalonia repo and has no 12.1.0 build yet. -->
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- CLI -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- 3.1.5, not the 2.x line - the runner itself supports "xUnit.net 1.9.2 and later" regardless
         of the runner's own major version (confirmed on the package's own NuGet listing), so this one
         central pin covers both the xunit v2 projects above and PolyTerm.App.Tests' xunit v3 below;
         no per-project VersionOverride needed. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- xunit v3 - only for PolyTerm.App.Tests, which needs Avalonia.Headless.XUnit 12.1.0's
         [AvaloniaFact]; that package now depends on xunit v3 instead of v2 (a real ecosystem break,
         not caught until the Avalonia 12 migration build). Every other test project stays on xunit
         v2 above. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- AwesomeAssertions, not FluentAssertions: a community fork staying on Apache-2.0 permanently
         (FluentAssertions >=8 requires a paid commercial license via Xceed) - same API surface and
         type names, just a different root namespace, so this was a package-name/namespace swap only,
         no assertion-syntax rewrite. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Real native-window UI automation for PolyTerm.exe itself (docs/testing.md's FlaUI spike,
         confirmed viable: physical Mouse.Click on a real ribbon button genuinely opened a window) -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>
